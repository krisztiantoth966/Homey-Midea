  "drivers": [
    {
      "id": "ac",
      "name": {
        "en": "Midea Air Conditioner",
        "sk": "Midea klimatizácia"
      },
      "class": "thermostat",
      "capabilities": [
        "onoff",
        "target_temperature",
        "measure_temperature",
        "measure_temperature.outdoor",
        "measure_humidity",
        "midea_mode",
        "midea_fan_speed",
        "midea_swing_mode",
        "measure_power",
        "meter_power",
        "midea_energy_source",
        "midea_eco",
        "midea_turbo",
        "midea_sleep",
        "midea_display",
        "midea_frost_protect",
        "midea_breezeless",
        "midea_purifier",
        "midea_beep",
        "midea_self_clean",
        "alarm_generic",
        "midea_error_code"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 16,
          "max": 30,
          "step": 0.5,
          "units": {
            "en": "°C",
            "sk": "°C"
          }
        },
        "measure_temperature": {
          "title": {
            "en": "Indoor temperature",
            "sk": "Vnútorná teplota"
          }
        },
        "measure_temperature.outdoor": {
          "title": {
            "en": "Outdoor temperature",
            "sk": "Vonkajšia teplota"
          }
        },
        "measure_humidity": {
          "title": {
            "en": "Indoor humidity",
            "sk": "Vnútorná vlhkosť"
          }
        },
        "measure_power": {
          "title": {
            "en": "Current power",
            "sk": "Aktuálny príkon"
          },
          "approximated": false
        },
        "meter_power": {
          "title": {
            "en": "Energy consumption",
            "sk": "Spotreba energie"
          }
        },
        "alarm_generic": {
          "title": {
            "en": "AC error",
            "sk": "Chyba klimatizácie"
          }
        }
      },
      "connectivity": [
        "lan",
        "cloud"
      ],
      "platforms": [
        "local"
      ],
      "images": {
        "small": "/drivers/ac/assets/images/small.png",
        "large": "/drivers/ac/assets/images/large.png",
        "xlarge": "/drivers/ac/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "start"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "options": {
            "singular": false
          },
          "navigation": {
            "prev": "start",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "repair"
        }
      ],
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP address",
            "sk": "IP adresa"
          },
          "value": "",
          "highlight": true,
          "hint": {
            "en": "Reserve this address in your router.",
            "sk": "Rezervujte túto adresu v routeri."
          }
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "LAN port",
            "sk": "LAN port"
          },
          "value": 6444,
          "min": 1,
          "max": 65535
        },
        {
          "id": "safe_mode",
          "type": "checkbox",
          "label": {
            "en": "Safe LAN mode (recommended)",
            "sk": "Bezpečný LAN režim (odporúčané)"
          },
          "value": true,
          "highlight": true,
          "hint": {
            "en": "Disables all periodic AC status queries and one-time capability/status probes. Homey keeps only the TCP heartbeat and listens for device push updates. This avoids the known Midea 35/88 display wake, beeping and Wi-Fi-reset issue. Applies while the AC is OFF and ON.",
            "sk": "Vypne všetky periodické stavové dotazy aj jednorazové capability/status dotazy. Homey ponechá iba TCP heartbeat a počúva aktívne hlásenia klimatizácie. Tým sa obchádza známy problém Midea s 35/88, pípaním, rozsvecovaním displeja a resetmi Wi-Fi. Platí pri vypnutej aj zapnutej klíme."
          }
        },
        {
          "id": "poll_interval",
